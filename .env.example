# Bridge
RIGHTONCLAW_HOST=127.0.0.1
RIGHTONCLAW_PORT=48765
RIGHTONCLAW_REQUEST_TIMEOUT_MS=75000

# OpenClaw
RIGHTONCLAW_OPENCLAW_CLIENT_MODE=mock
RIGHTONCLAW_OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
RIGHTONCLAW_OPENCLAW_BASE_URL=http://127.0.0.1:18789
RIGHTONCLAW_OPENCLAW_AGENT_ID=main

# Optional auth
# RIGHTONCLAW_OPENCLAW_GATEWAY_TOKEN=
# RIGHTONCLAW_OPENCLAW_GATEWAY_PASSWORD=
# RIGHTONCLAW_LOCAL_TOKEN=

# Optional API-key backend / model path
# RIGHTONCLAW_MODEL_API_KEY=
# RIGHTONCLAW_MODEL_BASE_URL=
# RIGHTONCLAW_MODEL_NAME=

# Optional fast-path flags
# RIGHTONCLAW_SUMMARIZE_FAST_PATH=1
# RIGHTONCLAW_EXPLAIN_FAST_PATH=1
