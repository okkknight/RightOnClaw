{
  "name": "rightonclaw",
  "version": "0.1.0",
  "description": "RightOnClaw - macOS AI action layer. Select something, then ask Claw.",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/okkknight/RightOnClaw"
  },
  "homepage": "https://github.com/okkknight/RightOnClaw#readme",
  "author": "Lin Peiwen",
  "keywords": ["macos", "ai", "assistant", "automation", "openclaw"],
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "corepack pnpm --filter @rightonclaw/bridge-server dev",
    "smoke:experimental": "tsx scripts/smoke-experimental-actions.ts",
    "smoke:openclaw": "tsx scripts/smoke-test-openclaw.ts",
    "start": "corepack pnpm --filter @rightonclaw/bridge-server start",
    "test": "corepack pnpm -r --if-present test",
    "typecheck": "corepack pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2"
  }
}
